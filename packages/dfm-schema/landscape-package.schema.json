{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jdhart81/hdfm-framework/packages/dfm-schema/landscape-package.schema.json",
  "title": "DFM Landscape Package v1",
  "description": "WGS84 GeoJSON layers, parameters and source records exchanged between DFM tools and VergeCommon. Lengths in meters, areas in square meters. Optional spine layers (streams, connectors, exits), properties for projections, and stand origin, native composition and planting records are additive: a package without them is unchanged.",
  "type": "object",
  "required": [
    "dfm_package",
    "crs",
    "units",
    "params",
    "layers"
  ],
  "properties": {
    "dfm_package": {
      "const": "1.0"
    },
    "name": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "string"
    },
    "crs": {
      "const": "EPSG:4326"
    },
    "units": {
      "type": "object",
      "properties": {
        "length": {
          "const": "m"
        },
        "area": {
          "const": "m2"
        }
      },
      "required": [
        "length",
        "area"
      ]
    },
    "params": {
      "type": "object",
      "required": [
        "minWidthM",
        "minWidthSource"
      ],
      "properties": {
        "minWidthM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "minWidthSource": {
          "type": "string",
          "minLength": 1
        },
        "roadWidthM": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "pinchFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spineWidthByOrderM": {
          "description": "Spine corridor width in meters by stream (Strahler) order; each at least minWidthM and never decreasing with order.",
          "type": "object",
          "propertyNames": {
            "pattern": "^([1-9]|1[0-2])$"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2000
          }
        },
        "spineWidthSource": {
          "type": "string",
          "minLength": 1
        },
        "connectorWidthM": {
          "description": "Width in meters of spine links (connectors) that do not record their own width_m; at least minWidthM.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "connectorWidthSource": {
          "type": "string",
          "minLength": 1
        },
        "junctionSnapM": {
          "description": "Distance within which a line end joins another line (spine network).",
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        },
        "ageAsOfYear": {
          "description": "Year that habitat ages and consent are recorded for.",
          "type": "integer",
          "minimum": 1800,
          "maximum": 3000
        },
        "oldGrowthAgeYears": {
          "description": "Age at which retained habitat counts as old-growth age in projections (age, not condition). Remnants count from the start.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "oldGrowthAgeSource": {
          "type": "string",
          "minLength": 1
        },
        "milestoneYears": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 3000
          },
          "maxItems": 12
        },
        "coreTempSource": {
          "description": "Where core temp_c values come from (for example a 30-year climate normal).",
          "type": "string",
          "minLength": 1
        },
        "climateWarmingC": {
          "description": "Warming target in degrees C for climate routes.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "climateSource": {
          "type": "string",
          "minLength": 1
        },
        "disturbanceWidthM": {
          "description": "Width of the single disturbance the spine network is tested against (default: the widest corridor plus 2 m; with stepping stones, wide enough that a cut across that corridor leaves a gap longer than gapCrossingM).",
          "type": "number",
          "minimum": 1,
          "maximum": 2000
        },
        "gapCrossingM": {
          "description": "Stepping stones: habitat at least minWidthM across, separated by at most this many meters, counts as linked. A gap never crosses a road without a recorded crossing. 0 or absent: corridors only.",
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "gapCrossingSource": {
          "description": "Where the gap-crossing distance comes from, such as a dispersal study for the species the corridors serve.",
          "type": "string",
          "minLength": 1
        },
        "nativeShareMin": {
          "description": "Projections: habitat counts at old-growth age only where it records a native_share at or above this share (0-1). Needs nativeShareSource.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "nativeShareSource": {
          "description": "Where the minimum native share comes from, such as a state natural community classification or a co-op policy.",
          "type": "string",
          "minLength": 1
        },
        "nativeStatusSource": {
          "description": "Where the native status of planted species comes from, such as a state flora or the USDA PLANTS database. When set, every restoration planting permitted inside corridors and cores must list its species.",
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Parameters with a recorded source for every width, age and temperature that changes a result.",
      "allOf": [
        {
          "if": {
            "properties": {
              "gapCrossingM": {
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "gapCrossingM"
            ]
          },
          "then": {
            "required": [
              "gapCrossingSource"
            ]
          }
        },
        {
          "if": {
            "required": [
              "nativeShareMin"
            ]
          },
          "then": {
            "required": [
              "nativeShareSource"
            ]
          }
        }
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object"
              }
            }
          }
        },
        "parcels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object",
                "properties": {
                  "dfm_id": {
                    "type": "string"
                  },
                  "consent": {
                    "enum": [
                      "covered",
                      "none"
                    ]
                  },
                  "consent_ref": {
                    "type": "string"
                  },
                  "consent_year": {
                    "description": "Year covering consent began; not after params.ageAsOfYear.",
                    "type": "integer",
                    "minimum": 1800,
                    "maximum": 3000
                  },
                  "planned_year": {
                    "description": "Year a parcel without consent plans to join (projections only).",
                    "type": "integer",
                    "minimum": 1800,
                    "maximum": 3000
                  }
                },
                "required": [
                  "dfm_id",
                  "consent"
                ]
              }
            }
          }
        },
        "coreAreas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object",
                "properties": {
                  "dfm_id": {
                    "type": "string",
                    "pattern": "^[^|]+$"
                  },
                  "core_class": {
                    "enum": [
                      "old-growth-candidate",
                      "old-growth-verified",
                      "riparian-core",
                      "reserve"
                    ]
                  },
                  "evidence_id": {
                    "type": "string"
                  },
                  "temp_c": {
                    "description": "Mean temperature of the core in degrees C, from params.coreTempSource.",
                    "type": "number",
                    "minimum": -60,
                    "maximum": 60
                  },
                  "stand_age": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3000
                  },
                  "remnant": {
                    "description": "Never plowed or clear-cut: at old-growth age in every projection year. Needs remnant_source.",
                    "type": "boolean"
                  },
                  "remnant_source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stand_origin": {
                    "description": "How the habitat was established, as defined in FAO's Global Forest Resources Assessment: natural (naturally regenerating), planted (planted or seeded, not a plantation) or plantation (planted, intensively managed, one or two species, even-aged, regularly spaced). A plantation never counts at old-growth age in projections. Needs origin_source.",
                    "enum": [
                      "natural",
                      "planted",
                      "plantation"
                    ]
                  },
                  "origin_source": {
                    "description": "Where the stand origin comes from, such as a stand inventory or planting record.",
                    "type": "string",
                    "minLength": 1
                  },
                  "native_share": {
                    "description": "Share (0-1) of the habitat's cover or basal area in species native to the place. Needs composition_source.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "composition_source": {
                    "description": "Where the native share comes from, such as a vegetation survey or stand inventory.",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "dfm_id",
                  "core_class"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "remnant": {
                          "const": true
                        }
                      },
                      "required": [
                        "remnant"
                      ]
                    },
                    "then": {
                      "required": [
                        "remnant_source"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "stand_origin"
                      ]
                    },
                    "then": {
                      "required": [
                        "origin_source"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "native_share"
                      ]
                    },
                    "then": {
                      "required": [
                        "composition_source"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "remnant": {
                          "const": true
                        }
                      },
                      "required": [
                        "remnant"
                      ]
                    },
                    "then": {
                      "properties": {
                        "stand_origin": {
                          "not": {
                            "const": "plantation"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "retained": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object",
                "properties": {
                  "stand_age": {
                    "description": "Years since the habitat was established as of params.ageAsOfYear: a forest stand's age, or years since a prairie was seeded.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3000
                  },
                  "spine": {
                    "type": "boolean"
                  },
                  "origin": {
                    "enum": [
                      "stream",
                      "ridge",
                      "valley",
                      "saddle",
                      "swale",
                      "escarpment",
                      "moraine",
                      "shoreline",
                      "right-of-way",
                      "field-margin",
                      "hedgerow",
                      "planned"
                    ]
                  },
                  "source_id": {
                    "type": "string"
                  },
                  "stream_order": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "width_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "width_source": {
                    "type": "string"
                  },
                  "remnant": {
                    "description": "Never plowed or clear-cut: at old-growth age in every projection year. Needs remnant_source.",
                    "type": "boolean"
                  },
                  "remnant_source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "stand_origin": {
                    "description": "How the habitat was established, as defined in FAO's Global Forest Resources Assessment: natural (naturally regenerating), planted (planted or seeded, not a plantation) or plantation (planted, intensively managed, one or two species, even-aged, regularly spaced). A plantation never counts at old-growth age in projections. Needs origin_source.",
                    "enum": [
                      "natural",
                      "planted",
                      "plantation"
                    ]
                  },
                  "origin_source": {
                    "description": "Where the stand origin comes from, such as a stand inventory or planting record.",
                    "type": "string",
                    "minLength": 1
                  },
                  "native_share": {
                    "description": "Share (0-1) of the habitat's cover or basal area in species native to the place. Needs composition_source.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "composition_source": {
                    "description": "Where the native share comes from, such as a vegetation survey or stand inventory.",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "remnant": {
                          "const": true
                        }
                      },
                      "required": [
                        "remnant"
                      ]
                    },
                    "then": {
                      "required": [
                        "remnant_source"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "stand_origin"
                      ]
                    },
                    "then": {
                      "required": [
                        "origin_source"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "native_share"
                      ]
                    },
                    "then": {
                      "required": [
                        "composition_source"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "remnant": {
                          "const": true
                        }
                      },
                      "required": [
                        "remnant"
                      ]
                    },
                    "then": {
                      "properties": {
                        "stand_origin": {
                          "not": {
                            "const": "plantation"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "roads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "LineString",
                      "MultiLineString",
                      "Polygon",
                      "MultiPolygon"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object"
              }
            }
          }
        },
        "water": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object"
              }
            }
          }
        },
        "crossings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Point"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object",
                "properties": {
                  "dfm_id": {
                    "type": "string"
                  },
                  "passage": {
                    "enum": [
                      "verified",
                      "assumed",
                      "none"
                    ]
                  }
                },
                "required": [
                  "passage"
                ]
              }
            }
          }
        },
        "treatments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object",
                "properties": {
                  "dfm_id": {
                    "type": "string"
                  },
                  "period": {
                    "type": "string"
                  },
                  "intensity": {
                    "type": "string"
                  },
                  "corridor_permitted": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "species": {
                    "description": "For a restoration planting: every species planted, each with its native status. Inside corridors and cores a planting stays permitted only when every species is native and a native-status source is recorded.",
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "native"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "native": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "native_status_source": {
                    "description": "Where the native status of the listed species comes from; params.nativeStatusSource applies when this is absent.",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "dfm_id"
                ],
                "if": {
                  "properties": {
                    "corridor_permitted": {
                      "const": true
                    }
                  },
                  "required": [
                    "corridor_permitted"
                  ]
                },
                "then": {
                  "required": [
                    "intensity",
                    "reason"
                  ],
                  "properties": {
                    "intensity": {
                      "enum": [
                        "single-tree-selection",
                        "light-thinning",
                        "invasive-removal",
                        "restoration-planting",
                        "prescribed-burn",
                        "prescribed-grazing",
                        "late-season-mowing",
                        "brush-management"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "LineString",
                      "MultiLineString"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object",
                "properties": {
                  "dfm_id": {
                    "type": "string",
                    "pattern": "^[^|]+$"
                  },
                  "stream_order": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  }
                },
                "required": [
                  "dfm_id",
                  "stream_order"
                ]
              }
            }
          },
          "description": "Stream centerlines with Strahler order: the branches of the old-growth spine."
        },
        "connectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "LineString",
                      "MultiLineString"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object",
                "properties": {
                  "dfm_id": {
                    "type": "string",
                    "pattern": "^[^|]+$"
                  },
                  "kind": {
                    "description": "Landforms: ridge, valley, saddle, swale, escarpment, moraine (and other glacial ridges), shoreline. Land use: right-of-way, field-margin, hedgerow. planned: a link drawn where neither carries one.",
                    "enum": [
                      "ridge",
                      "valley",
                      "saddle",
                      "swale",
                      "escarpment",
                      "moraine",
                      "shoreline",
                      "right-of-way",
                      "field-margin",
                      "hedgerow",
                      "planned"
                    ]
                  },
                  "width_m": {
                    "description": "The link's own corridor width, for land use that fixes it (a right-of-way); at least minWidthM.",
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2000
                  },
                  "width_source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "dfm_id",
                  "kind"
                ],
                "dependentRequired": {
                  "width_m": [
                    "width_source"
                  ]
                }
              }
            }
          },
          "description": "Spine links along landforms (ridges, valleys, saddles, swales, escarpments, moraines, shorelines) or land use (rights-of-way, field margins, hedgerows); they close loops."
        },
        "exits": {
          "description": "Where the spine continues into a neighboring landscape (climate routes). Each exit is a polygon on the spine at the landscape edge, with the temperature of the ground it leads to.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "geometry",
              "properties"
            ],
            "properties": {
              "type": {
                "const": "Feature"
              },
              "geometry": {
                "type": "object",
                "required": [
                  "type",
                  "coordinates"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  }
                }
              },
              "properties": {
                "type": "object",
                "required": [
                  "dfm_id",
                  "temp_c"
                ],
                "properties": {
                  "dfm_id": {
                    "type": "string",
                    "pattern": "^[^|]+$"
                  },
                  "temp_c": {
                    "description": "Temperature in degrees C of the ground the spine continues into, from params.coreTempSource.",
                    "type": "number",
                    "minimum": -60,
                    "maximum": 60
                  },
                  "toward": {
                    "description": "The neighboring landscape or region the spine continues into.",
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
